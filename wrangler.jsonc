{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smart-grade-pro-th",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smart-grade-pro-th",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DRIVE_ROOT_ID": "1Y0SQQZVUi_WsAvN2WtuvN3rSPHJC-8_Y"
  },
  "observability": {
    "enabled": false
  }
}
